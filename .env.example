# Monorepo Root Environment Variables
# Copy this file to .env and fill in your values

# Frontend (Vite) — InsForge project credentials
VITE_INSFORGE_URL=https://your-project-id.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# API server / Vercel serverless — InsForge API key (npx @insforge/cli secrets get API_KEY)
INSFORGE_URL=https://your-project-id.us-east.insforge.app
INSFORGE_API_KEY=your_insforge_api_key_here

# Database — used by apps/api via Drizzle ORM
HOST=your-project-id.us-east.database.insforge.app
DATABASE=insforge
USER=postgres
PORT=5432
PASSWORD=your_database_password_here
SSL=require

# API Server (optional — uncomment to override default port 8080)
# PORT=8080

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Used by apps/api for server-side transaction init, verify, and webhook validation
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# Public URL of this app (used to build the Paystack callback redirect URL)
APP_URL=https://your-production-domain.com

# Paystack Plan Codes — create plans at https://dashboard.paystack.com/#/plans
# and paste the generated plan codes (format: PLN_xxxxxxxxxxxxxxxxx)
VITE_PAYSTACK_STARTER_PLAN_CODE=PLN_your_starter_plan_code
VITE_PAYSTACK_PREMIUM_PLAN_CODE=PLN_your_premium_plan_code

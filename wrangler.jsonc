{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibook",
  "pages_build_output_dir": "apps/landing/dist/public",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "NIBOOK_IMAGES",
      "bucket_name": "nibook-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}

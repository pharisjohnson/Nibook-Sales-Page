# ---- Build stage ----
FROM node:22-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace manifests first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.json ./

# Copy all workspace packages needed for the API build
COPY lib/ ./lib/
COPY apps/api/ ./apps/api/

# Install deps (frozen lockfile for reproducible builds)
RUN pnpm install --frozen-lockfile --ignore-scripts=false

# Build the API (esbuild bundles everything into dist/index.mjs)
RUN pnpm --filter @workspace/api-server run build

# ---- Runtime stage ----
FROM node:22-slim AS runtime

WORKDIR /app

# The esbuild output is fully bundled — no node_modules needed
COPY --from=builder /app/apps/api/dist ./dist

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]

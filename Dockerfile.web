# ---- Build stage ----
FROM node:22-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

# Satisfy the workspace preinstall guard that checks npm_config_user_agent
ENV npm_config_user_agent="pnpm/0.0.0 node/v22.0.0 linux x64"

WORKDIR /app

# Copy workspace manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json tsconfig.json ./

# Copy all workspace packages the frontend depends on
COPY lib/ ./lib/
COPY apps/landing/ ./apps/landing/
COPY attached_assets/ ./attached_assets/

# VITE_ vars are baked into the bundle at build time
ARG VITE_INSFORGE_URL
ARG VITE_INSFORGE_ANON_KEY
ARG VITE_PAYSTACK_STARTER_PLAN_CODE
ARG VITE_PAYSTACK_PREMIUM_PLAN_CODE

ENV VITE_INSFORGE_URL=$VITE_INSFORGE_URL
ENV VITE_INSFORGE_ANON_KEY=$VITE_INSFORGE_ANON_KEY
ENV VITE_PAYSTACK_STARTER_PLAN_CODE=$VITE_PAYSTACK_STARTER_PLAN_CODE
ENV VITE_PAYSTACK_PREMIUM_PLAN_CODE=$VITE_PAYSTACK_PREMIUM_PLAN_CODE

RUN pnpm install --frozen-lockfile --ignore-scripts

RUN pnpm --filter @workspace/nibook-landing run build

# ---- Serve with nginx ----
FROM nginx:alpine AS runtime

COPY --from=builder /app/apps/landing/dist/public /usr/share/nginx/html
COPY apps/landing/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
